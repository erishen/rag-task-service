# RAG Task Service 配置示例
# 复制此文件为 .env 并填写实际值

# ===========================================
# 服务配置
# ===========================================

# 服务监听端口
PORT=3000

# 服务监听地址
HOST=127.0.0.1

# SQLite 数据库路径
DATABASE_PATH=data/app.db

# ===========================================
# 认证配置
# ===========================================

# API Key（可选，留空则禁用鉴权）
# 推荐用仓库提供的一键轮换：make gen-api-key（自动生成并写入 .env，旧键立即作废）
# 手工生成方式：openssl rand -hex 32
# 或：python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# 每秒请求数限制（per-IP）
RATE_LIMIT_PER_SEC=10

# ===========================================
# 向量库配置
# ===========================================

# 向量库后端：in_memory | lancedb | pgvector
#   in_memory / lancedb 不需要 PostgreSQL；pgvector 需 DATABASE_URL（下方）
VECTOR_STORE=lancedb

# LanceDB 数据目录
LANCEDB_PATH=data/lancedb

# PostgreSQL 连接串（仅 VECTOR_STORE=pgvector 需要）
# 本地 psql 直连：postgres://ws:ws@127.0.0.1:5433/ws
# Docker compose 内：postgres://ws:ws@postgres:5432/ws
DATABASE_URL=

# PostgreSQL 默认账号（Docker Compose 的 postgres 服务使用，本地部署可忽略）
POSTGRES_USER=ws
POSTGRES_PASSWORD=ws
POSTGRES_DB=ws

# ===========================================
# Embedding 配置
# ===========================================

# Embedding API 端点（留空使用本地 hash embedding）
# Ollama 示例：http://127.0.0.1:11434/v1
# OpenAI 兼容服务：https://api.openai.com/v1
EMBEDDING_API_BASE=

# Embedding API 密钥（Ollama 无需，OpenAI 需要）
EMBEDDING_API_KEY=

# Embedding 模型名
EMBEDDING_MODEL=nomic-embed-text

# ===========================================
# 检索配置
# ===========================================

# 检索模式：hybrid（BM25+向量）或 vector（纯向量）
SEARCH_MODE=hybrid

# RRF 融合常数（越大越平滑）
RRF_K=60

# ===========================================
# 重排配置
# ===========================================

# 重排模型名（留空禁用重排）
# 示例：llama3.1:8b
RERANK_MODEL=

# 重排 API 端点（留空回退到 EMBEDDING_API_BASE）
RERANK_API_BASE=

# 送入重排的候选数量
RERANK_TOP_N=20
